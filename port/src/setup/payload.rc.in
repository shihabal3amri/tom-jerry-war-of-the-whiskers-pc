// Generated by CMake from payload.rc.in -- the absolute paths are resolved at configure time.
#include <windows.h>
#include "setup/payload_ids.h"

IDI_TJSETUP            ICON    "@TJ_SETUP_ICON@"

IDR_TJ_LOADER          RCDATA  "@TJ_LOADER_EXE@"
IDR_TJ_HYBRID          RCDATA  "@TJ_HYBRID_DLL@"
IDR_MSVCP140           RCDATA  "@CRT_MSVCP140@"
IDR_MSVCP140_1         RCDATA  "@CRT_MSVCP140_1@"
IDR_MSVCP140_2         RCDATA  "@CRT_MSVCP140_2@"
IDR_MSVCP140_ATOMIC    RCDATA  "@CRT_MSVCP140_ATOMIC@"
IDR_VCRUNTIME140       RCDATA  "@CRT_VCRUNTIME140@"
IDR_VCRUNTIME140_THR   RCDATA  "@CRT_VCRUNTIME140_THR@"
IDR_CONCRT140          RCDATA  "@CRT_CONCRT140@"
IDR_README             RCDATA  "@TJ_README_TXT@"
@TJ_APK_RC@
@TJ_ARABIC_RC@

IDD_MAIN DIALOGEX 0, 0, 320, 214
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Install Tom & Jerry: War of the Whiskers"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    // Plain ASCII only in this file: the resource compiler eats "\x2014"-style escapes and
    // rendered the em dash as a literal "14" in the shipped dialog.
    LTEXT           "This installs the PC port. It contains no game data: choose your own disc image below, and the game files are extracted from it.",
                    IDC_INTRO, 10, 8, 300, 26
    LTEXT           "Disc image (.iso):", IDC_ISO_LABEL, 10, 42, 70, 9
    EDITTEXT        IDC_ISO_PATH, 10, 54, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_ISO_BROWSE, 256, 53, 54, 16
    LTEXT           "Install to:", IDC_DEST_LABEL, 10, 78, 70, 9
    EDITTEXT        IDC_DEST_PATH, 10, 90, 240, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_DEST_BROWSE, 256, 89, 54, 16
    CONTROL         "Create a &Desktop shortcut", IDC_SC_DESKTOP, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 114, 140, 10
    CONTROL         "Add to the &Start menu", IDC_SC_STARTMENU, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 160, 114, 140, 10
    CONTROL         "Also build an &Android app (one .apk, side-load and play)", IDC_ANDROID, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 130, 300, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 10, 150, 300, 12
    LTEXT           "", IDC_STATUS, 10, 168, 300, 18
    DEFPUSHBUTTON   "&Install", IDC_INSTALL, 196, 192, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 256, 192, 54, 16
END

IDD_UNINSTALL DIALOGEX 0, 0, 268, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Uninstall Tom & Jerry: War of the Whiskers"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_UN_TEXT, 10, 10, 248, 34
    CONTROL         "Also delete my &saved games and settings", IDC_UN_KEEPSAVES, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 10, 50, 200, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 10, 66, 248, 10
    DEFPUSHBUTTON   "&Uninstall", IDOK, 144, 88, 54, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 204, 88, 54, 16
END

1 VERSIONINFO
FILEVERSION    1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS         0x4L
FILETYPE       0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Tom & Jerry: War of the Whiskers - PC port installer"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "ProductName",     "Tom & Jerry: War of the Whiskers (PC port)"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
